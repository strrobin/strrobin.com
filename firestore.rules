rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Submission validation
    function isValidSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt']) &&
             data.keys().size() >= 3 && data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.createdAt == request.time &&
             (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 200));
    }

    // Newsletter validation
    function isValidNewsletter(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().size() == 2 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.createdAt == request.time;
    }

    match /submissions/{submissionId} {
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
      allow read, update, delete: if false;
    }

    match /newsletters/{newsletterId} {
      allow create: if isValidId(newsletterId) && isValidNewsletter(incoming());
      allow read, update, delete: if false;
    }
  }
}
